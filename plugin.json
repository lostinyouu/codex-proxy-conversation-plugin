{
  "manifestVersion": 2,
  "name": "conversation-lab",
  "displayName": "对话实验室",
  "publisher": "lostinyouu",
  "version": "0.1.0",
  "description": "保存固定或随机对话，选择模型手动发送并查看回复",
  "license": "Apache-2.0",
  "engines": {
    "codex-proxy-rs": ">=3.44.0, <4.0.0"
  },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "management": {
      "version": 2
    }
  },
  "configurationSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "resources": {
    "LICENSE": "text/plain",
    "NOTICE": "text/plain",
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css"
  },
  "state": [
    {
      "namespace": "presets",
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "required": [
          "entries"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "mode",
                "messages"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "mode": {
                  "enum": [
                    "fixed",
                    "random"
                  ]
                },
                "messages": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "required": [
                      "role",
                      "content"
                    ],
                    "properties": {
                      "role": {
                        "enum": [
                          "system",
                          "user",
                          "assistant"
                        ]
                      },
                      "content": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "maximumRecords": 1,
      "maximumBytes": 262144,
      "maximumValueBytes": 262144,
      "migratesFrom": []
    }
  ]
}
